  "redirects": [
    { "source": "/v1/about/admin-api-keys/models", "destination": "/v1/about/admin-api-keys" },
    { "source": "/v1/xrpl/:slug*", "destination": "/v1/xrp-ledger-xrpl/:slug*" }
  ],
  "navigation": {}
