{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Validation Cloud",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.validationcloud.io"
  },
  "navbar": {
    "links": [
      { "label": "Status", "href": "https://status.validationcloud.io/" },
      { "label": "Contact", "href": "https://www.validationcloud.io/contact" }
