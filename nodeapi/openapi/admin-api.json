            },
            "description": "Not Found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/admin.errorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "summary": "Per-endpoint compute-unit usage",
        "tags": [
          "Usage"
        ]
      }
    },
