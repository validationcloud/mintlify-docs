    "securitySchemes": {
      "AdminApiKey": {
        "description": "Admin API key under the `ApiKey` scheme: `Authorization: ApiKey vc_adm_...`. Each key is bound to one team and carries a READ or WRITE scope; the usage endpoints require only READ.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Programmatic, API-key-authenticated surface for managing\nValidation Cloud RPC endpoints and retrieving usage. Only the\ncurrently-implemented endpoints are documented; the broader PRD\nsurface is intentionally omitted until served.\n\n`/admin/v1` is a strict contract \u2014 breaking changes are made\nunder `/admin/v2`, never in place. Clients branch on the stable\n`error.code` enum, not on HTTP status alone.",
    "title": "Validation Cloud Node API \u2014 Admin API",
    "version": "1.0.0"
  },
  "externalDocs": {
    "description": "",
    "url": ""
  },
  "paths": {
    "/account": {
      "get": {
        "description": "Plan tier, compute-unit quota, cycle-to-date usage, and billing cycle bounds for the team the admin key is bound to. Unlimited-plan teams return `unlimited: true` with the quota and remaining fields omitted.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/admin.accountResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/admin.errorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/admin.errorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "summary": "Account information",
        "tags": [
          "Account"
        ]
      }
    },
    "/chains": {
