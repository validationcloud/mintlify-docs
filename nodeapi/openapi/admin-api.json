            "type": "string"
          },
          "billing_cycle_start": {
            "format": "date-time",
            "type": "string"
          },
          "cu_quota": {
            "example": 10000000,
            "format": "int64",
            "type": "integer"
          },
          "cu_remaining": {
            "example": 9765433,
            "format": "int64",
            "type": "integer"
          },
          "cu_used": {
            "example": 234567,
            "format": "int64",
            "type": "integer"
          },
