      },
      "post": {
        "description": "Mint a new RPC endpoint for the calling team. Subject to the per-team endpoint limit and the team's CU-quota gating (an over-quota team's endpoint is created disabled).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/admin.createEndpointRequest",
                "summary": "request",
                "description": "Endpoint to create"
              }
            }
          },
          "description": "Endpoint to create",
          "required": true
